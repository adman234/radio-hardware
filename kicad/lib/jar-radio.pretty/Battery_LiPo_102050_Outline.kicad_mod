  (fp_line (start -25.500 -10.500) (end 25.500 -10.500) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 25.500 -10.500) (end 25.500 10.500) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
